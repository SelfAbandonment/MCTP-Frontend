// 依赖巡检专用流水线：只做审计与清单，不跑构建和 Lighthouse。
// 在 Jenkins 里用一个独立任务指向本文件（Script Path = Jenkinsfile.dependency），
// 不要占用主 CI 任务的 Script Path。
pipeline {
    agent any

    tools {
        nodejs 'Nodejs24'
    }

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
    }

    stages {
        stage('安装依赖') {
            steps {
                sh 'npm ci --no-audit --no-fund'
            }
        }

        stage('安全审计') {
            steps {
                // 巡检任务只出报告，不因告警失败；主 CI 才是门禁
                sh 'npm audit --audit-level=moderate > npm-audit.txt 2>&1 || true'
                sh 'npm audit --json > npm-audit.json 2>&1 || true'
            }
        }

        stage('过期依赖') {
            steps {
                sh 'npm outdated > npm-outdated.txt 2>&1 || true'
            }
        }

        stage('依赖树') {
            steps {
                sh 'npm ls --all > dependency-tree.txt 2>&1 || true'
            }
        }

        stage('后端依赖审计') {
            steps {
                // 只出报告，不因漏洞失败；API 仓库用 uv 导出锁定依赖后再跑 pip-audit
                sh '''
                    set -e
                    export PATH="$HOME/.local/bin:$PATH"
                    if ! command -v uv >/dev/null 2>&1; then
                        echo "未找到 uv，安装到用户目录的 .local/bin"
                        curl -LsSf https://astral.sh/uv/install.sh | sh
                    fi
                    rm -rf api-repo
                    git clone --depth 1 https://github.com/SelfAbandonment/MCTP-API.git api-repo
                    cd api-repo
                    uv export --frozen --no-dev --format requirements-txt --output-file requirements.txt
                    uvx --from pip-audit pip-audit -r requirements.txt > ../pip-audit.txt 2>&1 || true
                    uvx --from pip-audit pip-audit -r requirements.txt -f json -o ../pip-audit.json || true
                '''
            }
        }

        stage('同步巡检 Issue') {
            steps {
                // 有漏洞则新建/更新 Issue，清零则自动关闭；失败不影响巡检结果
                withCredentials([usernamePassword(credentialsId: 'github-MCTP', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
                    withEnv([
                        "GH_REPO_FE=SelfAbandonment/MCTP-Frontend",
                        "GH_REPO_API=SelfAbandonment/MCTP-API"
                    ]) {
                        sh 'node scripts/security-issue.mjs || echo "巡检 Issue 同步失败（不影响构建结果）"'
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'dependency-tree.txt,npm-audit.txt,npm-audit.json,npm-outdated.txt,pip-audit.txt,pip-audit.json', allowEmptyArchive: true
        }
    }
}
